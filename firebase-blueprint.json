{
  "entities": {
    "SystemBootstrap": {
      "title": "SystemBootstrap",
      "description": "Registro único de inicialização que garante que o primeiro usuário cadastrado seja o ADM Titular.",
      "type": "object",
      "properties": {
        "initialized": {
          "type": "boolean",
          "description": "Indica se o primeiro ADM Titular já foi cadastrado."
        },
        "firstAdminUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do primeiro ADM Titular."
        },
        "firstAdminEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "E-mail do primeiro ADM Titular."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        }
      },
      "required": ["initialized", "firstAdminUid", "firstAdminEmail", "createdAt"]
    },
